# Copy values into your user/session environment. Do not commit real keys.

# Anthropic API. Lead frontier model that plans, synthesizes, and writes patches.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# OpenAI API. Secondary lead frontier model / direct OpenAI calls.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Google Gemini API.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# NVIDIA NIM / hosted open models.
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.1-70b-instruct
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Moonshot/Kimi. Confirm current model names in your Moonshot console.
# Keep this disabled while using NVIDIA-hosted Kimi instead of direct Moonshot billing.
DISABLED_PROVIDERS=Kimi / Moonshot
MOONSHOT_API_KEY=
MOONSHOT_MODEL=kimi-k2-0905-preview
MOONSHOT_BASE_URL=https://api.moonshot.ai/v1
